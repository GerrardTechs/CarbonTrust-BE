<!-- ROLES -->
<div class="section">
<h2>👥 Roles &amp; Akses</h2>
<table>
<tr><th width="90">Role</th><th>Registrasi</th><th>Akses</th></tr>
<tr><td><span class="auth company">company</span></td><td>POST /auth/register-company</td><td>Company CRUD, Parcels, Emissions, Bids, Certificates, IoT</td></tr>
