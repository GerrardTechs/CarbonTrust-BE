<!-- AUTH -->
<div class="section" id="auth">
<h2>🔐 Auth &amp; Session</h2>
<table>
<tr><th width="55">Method</th><th width="240">Endpoint</th><th width="70">Auth</th><th width="200">Request Body</th><th>Response 200</th><th width="90">Status</th></tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/auth/register-company</td>
  <td><span class="auth public">public</span></td>
  <td><code>name, email, username, password, companyType, position, officeAddress, siteAddress, emissionObject, institutionId?</code></td>
  <td class="desc"><code>{success, token, user{id,name,email,role,walletId,companyId}}</code><br><span class="note">409 email/username duplikat | rate limit 10/15min</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/auth/login</td>
  <td><span class="auth public">public</span></td>
  <td><code>email? | username?, password</code></td>
  <td class="desc"><code>{success, token, user{id,name,role,email,walletId,esgScore}}</code><br><span class="note">404 akun tidak ada | 401 password salah | rate limit 10/15min</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/auth/logout</td>
  <td><span class="auth any">any</span></td>
  <td><span class="note">— (token dari header)</span></td>
  <td class="desc"><code>{success: true}</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/auth/register-landlord</td>
  <td><span class="auth public">public</span></td>
  <td><code>name, email, username, password, phone?, location?</code></td>
  <td class="desc"><code>{success, token, user{id,name,role:"landlord",walletId}}</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/auth/admin-login</td>
  <td><span class="auth public">public</span></td>
  <td><code>username, password</code></td>
  <td class="desc"><code>{success, token, user{id,name,role:"admin"}}</code><br><span class="note">401 kredensial salah | rate limit 10/15min</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/auth/me</td>
  <td><span class="auth any">any</span></td>
  <td><span class="note">—</span></td>
  <td class="desc"><code>{success, user{id,name,email,role,esgScore,...}}</code></td>
  <td class="ok">✅ Ada</td>
</tr>
</table>
</div>

<!-- COMPANY -->
<div class="section" id="company">
<h2>🏢 Company</h2>
<table>
<tr><th width="55">Method</th><th width="240">Endpoint</th><th width="70">Auth</th><th width="200">Request Body</th><th>Response 200</th><th width="90">Status</th></tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/company/:id</td>
  <td><span class="auth any">any*</span></td>
  <td><span class="note">—</span></td>
  <td class="desc"><code>{id,name,email,entity,bizType,location,siteAddress,walletId,esgScore,esgStatus,isoCertVerified,stockData,totalTransactions,createdAt}</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m PUT">PUT</span></td>
  <td class="ep">/company/:id</td>
  <td><span class="auth company">company/landlord</span></td>
  <td><code>name?, entity?, bizType?, location?, siteAddress?, emissionObject?, stockData?</code><br><span class="note">walletId tidak bisa diubah</span></td>
  <td class="desc"><code>{success, ...updatedCompany}</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m PUT">PUT</span></td>
  <td class="ep">/company/:id/stock</td>
  <td><span class="auth company">company</span></td>
  <td><code>symbol, price, prevPrice</code></td>
  <td class="desc"><code>{success, symbol, price, prevPrice, updatedAt}</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/company/:id/upload-iso</td>
  <td><span class="auth company">company</span></td>
  <td><code>multipart: isoCert (PDF/JPG/PNG, max 10MB)</code></td>
  <td class="desc"><code>{success, filePath, isoCertVerified:false, message:"Menunggu verifikasi admin"}</code><br><span class="rl">⏱ 20 upload/jam</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/company/:id/upload-ownership</td>
  <td><span class="auth company">company</span></td>
  <td><code>multipart: ownershipDoc (PDF/JPG/PNG) + equityPct, country?, docType?</code></td>
  <td class="desc"><code>{success, filePath, equityPct}</code><br><span class="rl">⏱ 20 upload/jam</span></td>
  <td class="ok">✅ Ada</td>
</tr>
</table>
</div>

<!-- PARCELS -->
<div class="section" id="parcel">
<h2>🌱 Parcels (Lahan)</h2>
<table>
<tr><th width="55">Method</th><th width="240">Endpoint</th><th width="70">Auth</th><th width="200">Request Body / Query</th><th>Response 200</th><th width="90">Status</th></tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/parcels?companyId=</td>
  <td><span class="auth any">any*</span></td>
  <td><code>query: companyId (wajib)</code></td>
  <td class="desc"><code>[{id,companyId,name,type,area,status,ndvi,lat,lng,depth,humidity,locType,lastSat,absorptionMonthly}]</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/parcels</td>
  <td><span class="auth company">company/landlord</span></td>
  <td><code>companyId, name, type, area, lat, lng, depth? (wajib jika peatland), humidity?, locType ("site"|"office")</code></td>
  <td class="desc"><code>{id,companyId,name,type,area,status,ndvi,lat,lng,depth,humidity,locType,lastSat}</code><br><span class="note">+ auto-init 216 data point IoT simulasi</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m PATCH">PATCH</span></td>
  <td class="ep">/parcels/:id/status</td>
  <td><span class="auth company">company/landlord</span></td>
  <td><code>status: "healthy"|"flooded"|"degraded"|"burned"|"drying"</code></td>
  <td class="desc"><code>{...updatedParcel}</code><br><span class="note">Auto-alert jika bukan healthy | emit WS parcel_updated</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m PATCH">PATCH</span></td>
  <td class="ep">/parcels/:id/humidity</td>
  <td><span class="auth company">company/landlord</span></td>
  <td><code>humidity: number (0–100)</code></td>
  <td class="desc"><code>{...updatedParcel, absorptionMonthly}</code><br><span class="note">Peatland &lt;40% → auto critical alert | recalc absorption</span></td>
  <td class="ok">✅ Ada</td>
</tr>
</table>
</div>

<!-- EMISSION -->
<div class="section" id="emission">
<h2>💨 Emisi &amp; Kalkulasi</h2>
<table>
<tr><th width="55">Method</th><th width="240">Endpoint</th><th width="70">Auth</th><th width="200">Request Body</th><th>Response 200</th><th width="90">Status</th></tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/emissions/calculate-v2</td>
  <td><span class="auth company">company</span></td>
  <td><code>companyId, method ("operational"|"equity"), equityPct?, inputs{genset,boiler,furnace,lpg,naturalGas,coal,truck,smallTruck,opCar,bus,diesel,petrol,refrigerant,electricity,heatSteam,freightRoad,freightRoadTons,freightShip,freightShipTons,fuelDelivery,bizTravel,commuting,waste}</code></td>
  <td class="desc"><code>{success, scope1, scope2, scope3, total, leakage, creditsNeeded, breakdown[{key,source,val,unit,ef,emission,scope}]}</code><br><span class="rl">⏱ 30 req/menit</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/emissions/history/:companyId</td>
  <td><span class="auth company">company</span></td>
  <td><span class="note">—</span></td>
  <td class="desc"><code>{success, records[...20 terbaru]}</code></td>
  <td class="ok">✅ Ada</td>
</tr>
</table>
</div>

<!-- BIDS -->
<div class="section" id="bids">
<h2>💰 Bidding</h2>
<table>
<tr><th width="55">Method</th><th width="240">Endpoint</th><th width="70">Auth</th><th width="200">Request Body / Query</th><th>Response 200</th><th width="90">Status</th></tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/bids?projectId=&amp;companyId=</td>
  <td><span class="auth company">company</span></td>
  <td><code>query: projectId?, companyId?</code></td>
  <td class="desc"><code>[{id,projectId,buyerCompanyId,buyerName,pricePerTon,volume,status,createdAt}]</code><br><span class="note">Diurutkan pricePerTon DESC</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/bids</td>
  <td><span class="auth company">company</span></td>
  <td><code>projectId, buyerCompanyId, buyerName, pricePerTon, volume?</code></td>
  <td class="desc"><code>{id,projectId,buyerCompanyId,buyerName,pricePerTon,status:"pending",createdAt}</code><br><span class="note">Emit WS new_bid | tidak bisa bid project sendiri</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m PATCH">PATCH</span></td>
  <td class="ep">/bids/:id/accept</td>
  <td><span class="auth company">company</span></td>
  <td><span class="note">—</span></td>
  <td class="desc"><code>{...updatedBid, status:"accepted"}</code><br><span class="note">Bid lain di project yang sama → rejected | emit WS bid_accepted</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m PATCH">PATCH</span></td>
  <td class="ep">/bids/:id/reject</td>
  <td><span class="auth company">company</span></td>
  <td><span class="note">—</span></td>
  <td class="desc"><code>{...updatedBid, status:"rejected"}</code></td>
  <td class="ok">✅ Ada</td>
</tr>
</table>
</div>

<!-- IOT -->
<div class="section" id="iot">
<h2>📡 IoT &amp; Sensor</h2>
<table>
<tr><th width="55">Method</th><th width="240">Endpoint</th><th width="70">Auth</th><th width="200">Request Body / Query</th><th>Response 200</th><th width="90">Status</th></tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/iot/:parcelId/history?hours=72</td>
  <td><span class="auth any">any*</span></td>
  <td><code>query: hours (default 72)</code></td>
  <td class="desc"><code>[{ts,temp,hum,co2,ndvi}]</code><br><span class="note">Difilter N jam terakhir</span></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m GET">GET</span></td>
  <td class="ep">/iot/company/:companyId?scope=</td>
  <td><span class="auth company">company</span></td>
  <td><code>query: scope ("office"|"site"|"all")</code></td>
  <td class="desc"><code>{office:[{parcelId,name,latest{ts,temp,hum,co2,ndvi}}], site:[...]}</code></td>
  <td class="ok">✅ Ada</td>
</tr>

<tr>
  <td><span class="m POST">POST</span></td>
  <td class="ep">/iot/:parcelId/push</td>
  <td><span class="auth public">device*</span></td>
  <td><code>temp, hum, co2, ndvi, ts?</code></td>
  <td class="desc"><code>{success, parcelId, data{ts,temp,hum,co2,ndvi}}</code><br><span class="note">Auto-alert: peatland hum&lt;40% | CO2&gt;1000ppm | emit WS iot_live</span><br><span class="rl">⏱ 60 req/menit (IoT device)</span></td>
  <td class="ok">✅ Ada</td>
</tr>
</table>
</div>

